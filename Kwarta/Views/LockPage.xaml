<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kwarta.ViewModels"
             xmlns:services="clr-namespace:Kwarta.Services"
             x:Class="Kwarta.Views.LockPage"
             x:DataType="vm:LockViewModel"
             Shell.NavBarIsVisible="False"
             Title="Kwarta locked">

    <ContentPage.Resources>
        <Style TargetType="Button" x:Key="Key">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ChipLight}, Dark={StaticResource ChipDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="WidthRequest" Value="72" />
            <Setter Property="HeightRequest" Value="72" />
            <Setter Property="CornerRadius" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="Command" Value="{Binding DigitCommand}" />
        </Style>
        <Style TargetType="Button" x:Key="IconKey" BasedOn="{StaticResource Key}">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontFamily" Value="MaterialIcons" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout VerticalOptions="Center" Spacing="24" Padding="20" MaximumWidthRequest="360">
        <VerticalStackLayout Spacing="8">
            <Label Text="{x:Static services:Icons.Lock}" Style="{StaticResource Icon}" FontSize="40"
                   TextColor="{StaticResource Primary}" />
            <Label Text="Enter your PIN" FontFamily="OpenSansSemibold" FontSize="20" HorizontalOptions="Center" />
            <Label Text="{Binding Dots}" FontSize="22" HorizontalOptions="Center" HeightRequest="32"
                   SemanticProperties.Description="Digits entered" />
            <Label Text="{Binding Message}" TextColor="{StaticResource Expense}" FontSize="13"
                   HorizontalOptions="Center" IsVisible="{Binding HasMessage}" />
        </VerticalStackLayout>

        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
            <Button Text="1" Style="{StaticResource Key}" CommandParameter="1" />
            <Button Grid.Column="1" Text="2" Style="{StaticResource Key}" CommandParameter="2" />
            <Button Grid.Column="2" Text="3" Style="{StaticResource Key}" CommandParameter="3" />
            <Button Grid.Row="1" Text="4" Style="{StaticResource Key}" CommandParameter="4" />
            <Button Grid.Row="1" Grid.Column="1" Text="5" Style="{StaticResource Key}" CommandParameter="5" />
            <Button Grid.Row="1" Grid.Column="2" Text="6" Style="{StaticResource Key}" CommandParameter="6" />
            <Button Grid.Row="2" Text="7" Style="{StaticResource Key}" CommandParameter="7" />
            <Button Grid.Row="2" Grid.Column="1" Text="8" Style="{StaticResource Key}" CommandParameter="8" />
            <Button Grid.Row="2" Grid.Column="2" Text="9" Style="{StaticResource Key}" CommandParameter="9" />
            <Button Grid.Row="3" Text="{x:Static services:Icons.Fingerprint}" Style="{StaticResource IconKey}"
                    Command="{Binding UseBiometricsCommand}" IsVisible="{Binding CanUseBiometrics}"
                    SemanticProperties.Description="Unlock with biometrics" />
            <Button Grid.Row="3" Grid.Column="1" Text="0" Style="{StaticResource Key}" CommandParameter="0" />
            <Button Grid.Row="3" Grid.Column="2" Text="{x:Static services:Icons.Backspace}" Style="{StaticResource IconKey}"
                    Command="{Binding BackspaceCommand}" SemanticProperties.Description="Delete digit" />
        </Grid>

        <Button Text="Unlock" Command="{Binding EnterCommand}" HeightRequest="50"
                FontFamily="OpenSansSemibold" CornerRadius="18" />
    </VerticalStackLayout>
</ContentPage>
