<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kwarta.ViewModels"
             x:Class="Kwarta.Views.PillGroupView"
             x:DataType="vm:PillGroup">

    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Options}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="vm:PillOption">
                <Button Text="{Binding Text}" Style="{StaticResource Chip}" Margin="0,0,8,8"
                        Command="{Binding SelectCommand, Source={RelativeSource AncestorType={x:Type vm:PillGroup}}}"
                        CommandParameter="{Binding .}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="FontFamily" Value="OpenSansSemibold" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </FlexLayout>
</ContentView>
