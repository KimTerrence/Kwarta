<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kwarta.ViewModels"
             xmlns:views="clr-namespace:Kwarta.Views"
             xmlns:services="clr-namespace:Kwarta.Services"
             x:Class="Kwarta.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Shell.NavBarIsVisible="False"
             Title="Overview">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,110" Spacing="16" MaximumWidthRequest="720">

                <!-- Backup reminder -->
                <Border Style="{StaticResource Card}" Padding="16,14" IsVisible="{Binding ShowBackupReminder}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Style="{StaticResource IconBubble}" BackgroundColor="#29E6A23C">
                            <Label Text="{x:Static services:Icons.Backup}" Style="{StaticResource Icon}"
                                   TextColor="{StaticResource Warning}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{Binding BackupReminderText}" FontSize="13" />
                            <Button Text="Back up now" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start"
                                    Command="{Binding BackUpNowCommand}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="{x:Static services:Icons.Close}" Style="{StaticResource MonthNavButton}"
                                VerticalOptions="Start" Command="{Binding DismissBackupReminderCommand}"
                                SemanticProperties.Description="Remind me later" />
                    </Grid>
                </Border>

                <views:MonthHeader />

                <!-- Hero: balance with income/expense tiles -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 28" Padding="22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource HeroStart}" Offset="0" />
                            <GradientStop Color="{StaticResource HeroEnd}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#0E5A3E" Opacity="0.3" Radius="24" Offset="0,10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Balance this month" TextColor="#CCFFFFFF" FontSize="13" />
                            <Label Text="{Binding BalanceText}" TextColor="White"
                                   FontFamily="OpenSansSemibold" FontSize="48" />
                            <Border IsVisible="{Binding IsOverspent}" HorizontalOptions="Start"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,4"
                                    BackgroundColor="#33FFFFFF">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{x:Static services:Icons.Warning}" Style="{StaticResource Icon}"
                                           FontSize="16" TextColor="White" />
                                    <Label Text="Spending is higher than income" TextColor="White" FontSize="12"
                                           VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14,12"
                                    BackgroundColor="#26FFFFFF">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="32" HeightRequest="32"
                                            BackgroundColor="#33FFFFFF">
                                        <Label Text="{x:Static services:Icons.ArrowDown}" Style="{StaticResource Icon}"
                                               FontSize="18" TextColor="White" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="Income" TextColor="#CCFFFFFF" FontSize="12" />
                                        <Label Text="{Binding IncomeText}" TextColor="White" FontFamily="OpenSansSemibold"
                                               FontSize="15" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14,12"
                                    BackgroundColor="#26FFFFFF">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="32" HeightRequest="32"
                                            BackgroundColor="#33FFFFFF">
                                        <Label Text="{x:Static services:Icons.ArrowUp}" Style="{StaticResource Icon}"
                                               FontSize="18" TextColor="White" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="Expenses" TextColor="#CCFFFFFF" FontSize="12" />
                                        <Label Text="{Binding ExpensesText}" TextColor="White" FontFamily="OpenSansSemibold"
                                               FontSize="15" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>

                        <Label Text="{Binding BudgetSummaryText}" TextColor="#CCFFFFFF" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Quick add -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Quick add" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Manage" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ManageQuickAddsCommand}" VerticalOptions="End" />
                </Grid>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,-4,0,0">
                    <HorizontalStackLayout Spacing="10" Padding="0,4,0,8">
                        <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding QuickAdds}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TemplateItem">
                                    <Border Style="{StaticResource Card}" Padding="12,10" StrokeShape="RoundRectangle 18"
                                            SemanticProperties.Description="{Binding Name, StringFormat='Quick add {0}'}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding QuickAddCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="10">
                                            <Border Style="{StaticResource IconBubble}" WidthRequest="36" HeightRequest="36"
                                                    StrokeShape="RoundRectangle 12" BackgroundColor="{Binding IconTint}">
                                                <Label Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18"
                                                       TextColor="{Binding IconColor}" />
                                            </Border>
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="13" />
                                                <Label Text="{Binding AmountText}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Border Style="{StaticResource Card}" Padding="14,10" StrokeShape="RoundRectangle 18" Shadow="{x:Null}"
                                BackgroundColor="Transparent" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                StrokeThickness="1" StrokeDashArray="4,3" SemanticProperties.Description="Add a quick-add">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ManageQuickAddsCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{x:Static services:Icons.Bolt}" Style="{StaticResource Icon}" FontSize="18"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="New" FontSize="13" VerticalTextAlignment="Center" TextColor="{StaticResource Primary}" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Upcoming bills and recurring transactions -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding HasUpcoming}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Upcoming" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="All" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ShowRecurringCommand}" VerticalOptions="End" />
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="16,4">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Upcoming}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecurringItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="0,10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding OpenUpcomingCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Border Style="{StaticResource IconBubble}" BackgroundColor="{Binding IconTint}">
                                            <Label Text="{Binding Glyph}" Style="{StaticResource Icon}" TextColor="{Binding IconColor}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="15"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding DueText}" FontSize="12" TextColor="{Binding DueColor}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding AmountText}" Style="{StaticResource Amount}"
                                               TextColor="{Binding AmountColor}" VerticalTextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Budgets -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Budgets" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Manage" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowBudgetsCommand}" VerticalOptions="End" />
                </Grid>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Label Text="No spending yet this month." Style="{StaticResource Caption}"
                               IsVisible="{Binding HasBudgets, Converter={StaticResource InvertedBool}}" />
                        <VerticalStackLayout Spacing="20" BindableLayout.ItemsSource="{Binding Budgets}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BudgetProgressItem">
                                    <views:BudgetRow />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Recent -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Recent" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="See all" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowAllTransactionsCommand}" VerticalOptions="End" />
                </Grid>
                <Border Style="{StaticResource Card}" Padding="18,8">
                    <Grid>
                        <VerticalStackLayout Padding="0,24" Spacing="6"
                                             IsVisible="{Binding HasTransactions, Converter={StaticResource InvertedBool}}">
                            <Label Text="{x:Static services:Icons.Receipt}" Style="{StaticResource Icon}" FontSize="40"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
                            <Label Text="No transactions yet" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
                            <Label Text="Tap + to record your first one." Style="{StaticResource Caption}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentTransactions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TransactionItem">
                                    <views:TransactionRow>
                                        <views:TransactionRow.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding EditTransactionCommand, Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                        </views:TransactionRow.GestureRecognizers>
                                    </views:TransactionRow>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Button Style="{StaticResource Fab}" Command="{Binding AddTransactionCommand}" />

        <!-- Quick-add confirmation -->
        <Border IsVisible="{Binding IsToastVisible}" VerticalOptions="End" HorizontalOptions="Start"
                Margin="20,0,96,32" Padding="16,6,6,6" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding ToastText}" VerticalTextAlignment="Center" FontSize="13" LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}" />
                <Button Grid.Column="1" Text="Undo" BackgroundColor="Transparent" FontFamily="OpenSansSemibold"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource Primary}}"
                        Command="{Binding UndoQuickAddCommand}" Padding="10,0" MinimumHeightRequest="36" />
            </Grid>
        </Border>

        <!-- Launch animation; hidden once it has played. -->
        <views:SplashOverlay x:Name="Splash" />
    </Grid>
</ContentPage>
