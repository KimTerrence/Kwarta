<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kwarta.ViewModels"
             xmlns:services="clr-namespace:Kwarta.Services"
             x:Class="Kwarta.Views.AccountEditPage"
             x:DataType="vm:AccountEditViewModel"
             Shell.TabBarIsVisible="False"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="18" MaximumWidthRequest="560">

            <!-- Preview -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" WidthRequest="80" HeightRequest="80"
                        HorizontalOptions="Center" BackgroundColor="{Binding Tint}">
                    <Label Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="40" TextColor="{Binding Color}" />
                </Border>
                <Label Text="{Binding PreviewName}" FontFamily="OpenSansSemibold" FontSize="18"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Type -->
            <Border Style="{StaticResource Segment}">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                    <Button Text="Cash" Style="{StaticResource Chip}" BackgroundColor="Transparent"
                            Command="{Binding SetCashCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsCash}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="E-wallet" Style="{StaticResource Chip}" BackgroundColor="Transparent"
                            Command="{Binding SetEWalletCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsEWallet}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="Bank" Style="{StaticResource Chip}" BackgroundColor="Transparent"
                            Command="{Binding SetBankCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsBank}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <!-- Name and starting balance -->
            <Border Style="{StaticResource Card}" Padding="18,6">
                <VerticalStackLayout>
                    <Entry Text="{Binding Name}" Placeholder="e.g. GCash, BDO Savings" MaxLength="30" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="{Binding CurrencySymbol}" VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Entry Grid.Column="1" Text="{Binding StartingBalanceText}" Keyboard="Numeric"
                               Placeholder="Starting balance (optional)" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label Text="The balance before your first recorded transaction in this account."
                   Style="{StaticResource Caption}" Margin="4,-10,4,0" />

            <!-- Color swatches -->
            <Label Text="Color" Style="{StaticResource SectionTitle}" Margin="4,0,0,0" />
            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding ColorOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableOption">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40"
                                Margin="0,0,12,12" BackgroundColor="{Binding Color}"
                                SemanticProperties.Description="{Binding Key}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectColorCommand, Source={RelativeSource AncestorType={x:Type vm:AccountEditViewModel}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{x:Static services:Icons.Check}" Style="{StaticResource Icon}"
                                   TextColor="White" IsVisible="{Binding IsSelected}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label Text="{Binding ErrorText}" TextColor="{StaticResource Expense}" IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />

            <Button Text="Save" Command="{Binding SaveCommand}" HeightRequest="54"
                    FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="18" />
            <Button Text="Delete account" Command="{Binding DeleteCommand}" IsVisible="{Binding IsExisting}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Expense}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
