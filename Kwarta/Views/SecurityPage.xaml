<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kwarta.ViewModels"
             xmlns:services="clr-namespace:Kwarta.Services"
             x:Class="Kwarta.Views.SecurityPage"
             x:DataType="vm:SecurityViewModel"
             Shell.TabBarIsVisible="False"
             Title="App lock">

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="14" MaximumWidthRequest="560">

            <VerticalStackLayout Spacing="10" Padding="0,12">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" WidthRequest="80" HeightRequest="80"
                        HorizontalOptions="Center" BackgroundColor="#293949AB">
                    <Label Text="{x:Static services:Icons.Lock}" Style="{StaticResource Icon}" FontSize="40" TextColor="#3949AB" />
                </Border>
                <Label Text="Ask for a PIN when Kwarta opens, or when you return to it after 30 seconds away."
                       Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Off -->
            <Button Text="Turn on app lock" Command="{Binding TurnOnCommand}" HeightRequest="54"
                    FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="18"
                    IsVisible="{Binding IsLockEnabled, Converter={StaticResource InvertedBool}}" />

            <!-- On -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsLockEnabled}">
                <Border Style="{StaticResource Card}" Padding="16,10" IsVisible="{Binding AreBiometricsAvailable}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Label Text="{x:Static services:Icons.Fingerprint}" Style="{StaticResource Icon}"
                               TextColor="{StaticResource Primary}" />
                        <Label Grid.Column="1" Text="{Binding BiometricsLabel}" FontSize="15" VerticalTextAlignment="Center" />
                        <Switch Grid.Column="2" IsToggled="{Binding UseBiometrics}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Button Text="Change PIN" Command="{Binding ChangePinCommand}" Style="{StaticResource SecondaryButton}"
                        HeightRequest="48" />
                <Button Text="Turn off app lock" Command="{Binding TurnOffCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Expense}" />
            </VerticalStackLayout>

            <Label Text="If you forget your PIN, the only way back in is to clear the app's data, so keep a backup."
                   Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
