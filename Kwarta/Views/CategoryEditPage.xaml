<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kwarta.ViewModels"
             xmlns:services="clr-namespace:Kwarta.Services"
             x:Class="Kwarta.Views.CategoryEditPage"
             x:DataType="vm:CategoryEditViewModel"
             Shell.TabBarIsVisible="False"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="18" MaximumWidthRequest="560">

            <!-- Preview -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" WidthRequest="80" HeightRequest="80"
                        HorizontalOptions="Center" BackgroundColor="{Binding Tint}">
                    <Label Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="40" TextColor="{Binding Color}" />
                </Border>
                <Label Text="{Binding PreviewName}" FontFamily="OpenSansSemibold" FontSize="18"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Name and budget -->
            <Border Style="{StaticResource Card}" Padding="18,6">
                <VerticalStackLayout>
                    <Entry Text="{Binding Name}" Placeholder="Category name" MaxLength="30" />
                    <VerticalStackLayout IsVisible="{Binding IsExpense}">
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Label Text="{Binding CurrencySymbol}" VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Entry Grid.Column="1" Text="{Binding BudgetText}" Keyboard="Numeric"
                                   Placeholder="Monthly budget (optional)" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Roll over unspent budget" FontSize="15" />
                                <Label Text="What's left at month end is added to next month's budget."
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding Rollover}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Icon grid -->
            <Label Text="Icon" Style="{StaticResource SectionTitle}" Margin="4,0,0,0" />
            <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding IconOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableOption">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="44" HeightRequest="44"
                                Margin="0,0,8,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                                SemanticProperties.Description="{Binding Key}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectIconCommand, Source={RelativeSource AncestorType={x:Type vm:CategoryEditViewModel}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Glyph}" Style="{StaticResource Icon}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Color swatches -->
            <Label Text="Color" Style="{StaticResource SectionTitle}" Margin="4,0,0,0" />
            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding ColorOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableOption">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40"
                                Margin="0,0,12,12" BackgroundColor="{Binding Color}"
                                SemanticProperties.Description="{Binding Key}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectColorCommand, Source={RelativeSource AncestorType={x:Type vm:CategoryEditViewModel}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{x:Static services:Icons.Check}" Style="{StaticResource Icon}"
                                   TextColor="White" IsVisible="{Binding IsSelected}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label Text="{Binding ErrorText}" TextColor="{StaticResource Expense}" IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />

            <Button Text="Save" Command="{Binding SaveCommand}" HeightRequest="54"
                    FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="18" />
            <Button Text="Delete category" Command="{Binding DeleteCommand}" IsVisible="{Binding IsExisting}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Expense}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
