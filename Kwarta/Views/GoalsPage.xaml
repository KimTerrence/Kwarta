<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kwarta.ViewModels"
             xmlns:views="clr-namespace:Kwarta.Views"
             xmlns:services="clr-namespace:Kwarta.Services"
             x:Class="Kwarta.Views.GoalsPage"
             x:DataType="vm:GoalsViewModel"
             Shell.TabBarIsVisible="False"
             Title="Savings goals">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,12,20,110" Spacing="12" MaximumWidthRequest="720">

                <VerticalStackLayout Padding="0,48" Spacing="6" IsVisible="{Binding IsEmpty}">
                    <Label Text="{x:Static services:Icons.Savings}" Style="{StaticResource Icon}" FontSize="48"
                           TextColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
                    <Label Text="No goals yet" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
                    <Label Text="Set a target like an emergency fund, and link the account you save it in to track it automatically."
                           Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:GoalItem">
                            <Border Style="{StaticResource Card}" Padding="16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:GoalsViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Border Style="{StaticResource IconBubble}" BackgroundColor="{Binding Tint}">
                                            <Label Text="{Binding Glyph}" Style="{StaticResource Icon}" TextColor="{Binding Color}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="15" />
                                            <Label Text="{Binding SavedText}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding StatusText}" TextColor="{Binding StatusColor}"
                                               FontSize="12" FontFamily="OpenSansSemibold" VerticalTextAlignment="Center" />
                                    </Grid>
                                    <views:MeterBar Progress="{Binding Progress}" BarColor="{Binding Color}" HeightRequest="10" />
                                    <Label Text="{Binding SourceText}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Button Style="{StaticResource Fab}" Command="{Binding AddCommand}" SemanticProperties.Description="Add savings goal" />
    </Grid>
</ContentPage>
