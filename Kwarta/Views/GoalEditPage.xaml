<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kwarta.ViewModels"
             xmlns:views="clr-namespace:Kwarta.Views"
             xmlns:services="clr-namespace:Kwarta.Services"
             x:Class="Kwarta.Views.GoalEditPage"
             x:DataType="vm:GoalEditViewModel"
             Shell.TabBarIsVisible="False"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="18" MaximumWidthRequest="560">

            <Border Style="{StaticResource Card}" Padding="18,6">
                <VerticalStackLayout>
                    <Entry Text="{Binding Name}" Placeholder="e.g. Emergency fund" MaxLength="40" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="{Binding CurrencySymbol}" VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Entry Grid.Column="1" Text="{Binding TargetText}" Keyboard="Numeric" Placeholder="Target amount" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Account link -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Saved in" Style="{StaticResource SectionTitle}" Margin="4,0,0,0" />
                <Label Text="Link the account you keep this money in, and its balance counts as saved."
                       Style="{StaticResource Caption}" Margin="4,-6,4,0" />
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Accounts}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChipChoice">
                            <views:ChoiceChip>
                                <views:ChoiceChip.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectAccountCommand, Source={RelativeSource AncestorType={x:Type vm:GoalEditViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </views:ChoiceChip.GestureRecognizers>
                            </views:ChoiceChip>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="18,6"
                    IsVisible="{Binding IsLinked, Converter={StaticResource InvertedBool}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <Label Text="{Binding CurrencySymbol}" VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                    <Entry Grid.Column="1" Text="{Binding SavedText}" Keyboard="Numeric" Placeholder="Saved so far" />
                </Grid>
            </Border>

            <!-- Color swatches -->
            <Label Text="Color" Style="{StaticResource SectionTitle}" Margin="4,0,0,0" />
            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding ColorOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableOption">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40"
                                Margin="0,0,12,12" BackgroundColor="{Binding Color}"
                                SemanticProperties.Description="{Binding Key}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectColorCommand, Source={RelativeSource AncestorType={x:Type vm:GoalEditViewModel}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{x:Static services:Icons.Check}" Style="{StaticResource Icon}"
                                   TextColor="White" IsVisible="{Binding IsSelected}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label Text="{Binding ErrorText}" TextColor="{StaticResource Expense}" IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />

            <Button Text="Save" Command="{Binding SaveCommand}" HeightRequest="54"
                    FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="18" />
            <Button Text="Delete goal" Command="{Binding DeleteCommand}" IsVisible="{Binding IsExisting}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Expense}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
