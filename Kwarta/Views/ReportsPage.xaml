<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kwarta.ViewModels"
             xmlns:views="clr-namespace:Kwarta.Views"
             x:Class="Kwarta.Views.ReportsPage"
             x:DataType="vm:ReportsViewModel"
             Shell.TabBarIsVisible="False"
             Title="Reports">

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="14" MaximumWidthRequest="720">

            <views:MonthHeader />

            <!-- Spending this month -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Spent this month" Style="{StaticResource Caption}" />
                    <Label Text="{Binding SpentText}" FontFamily="OpenSansSemibold" FontSize="32" />
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding ChangeGlyph}" Style="{StaticResource Icon}" FontSize="16"
                               TextColor="{Binding ChangeColor}" />
                        <Label Text="{Binding ChangeText}" FontSize="13" TextColor="{Binding ChangeColor}"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding SavingsRateText}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <!-- Six-month trend. Bars are plain views; GraphicsView crashes on Windows when Shell tabs re-attach it. -->
            <Label Text="Last 6 months" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <FlexLayout Direction="Row" AlignItems="Stretch" HeightRequest="170"
                                BindableLayout.ItemsSource="{Binding Trend}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrendBar">
                                <Grid RowDefinitions="*,Auto" RowSpacing="6" FlexLayout.Grow="1" FlexLayout.Basis="0"
                                      SemanticProperties.Description="{Binding Description}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectMonthCommand, Source={RelativeSource AncestorType={x:Type vm:ReportsViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="End">
                                        <BoxView WidthRequest="12" HeightRequest="{Binding IncomeHeight}" CornerRadius="4,4,0,0"
                                                 Color="{StaticResource Income}" VerticalOptions="End" />
                                        <BoxView WidthRequest="12" HeightRequest="{Binding ExpenseHeight}" CornerRadius="4,4,0,0"
                                                 Color="{StaticResource Expense}" VerticalOptions="End" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Row="1" Text="{Binding Label}" Style="{StaticResource Caption}"
                                           HorizontalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="3" Color="{StaticResource Income}" />
                            <Label Text="Income" Style="{StaticResource Caption}" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="3" Color="{StaticResource Expense}" />
                            <Label Text="Spending" Style="{StaticResource Caption}" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Average monthly spending" Style="{StaticResource Caption}" VerticalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="{Binding AverageText}" Style="{StaticResource Amount}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Category breakdown -->
            <Label Text="Where it went" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Label Text="No spending this month." Style="{StaticResource Caption}"
                           IsVisible="{Binding HasCategories, Converter={StaticResource InvertedBool}}" />
                    <VerticalStackLayout Spacing="18" BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryShare">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource IconBubble}" WidthRequest="36" HeightRequest="36"
                                                StrokeShape="RoundRectangle 12" BackgroundColor="{Binding Tint}">
                                            <Label Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18"
                                                   TextColor="{Binding Color}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="14" />
                                            <Label Text="{Binding ShareText}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding AmountText}" Style="{StaticResource Amount}"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                    <views:MeterBar Progress="{Binding Share}" BarColor="{Binding Color}" HeightRequest="6" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
