<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kwarta.ViewModels"
             xmlns:services="clr-namespace:Kwarta.Services"
             xmlns:views="clr-namespace:Kwarta.Views"
             x:Class="Kwarta.Views.TransactionEditPage"
             x:DataType="vm:TransactionEditViewModel"
             Shell.TabBarIsVisible="False"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="18" MaximumWidthRequest="560">

            <!-- Expense / Income / Transfer segmented control -->
            <Border Style="{StaticResource Segment}">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                    <Button Text="Expense" Style="{StaticResource Chip}" BackgroundColor="Transparent"
                            Command="{Binding SetExpenseCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsExpense}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Expense}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Income" Style="{StaticResource Chip}" BackgroundColor="Transparent"
                            Command="{Binding SetIncomeCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsIncome}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Income}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="Transfer" Style="{StaticResource Chip}" BackgroundColor="Transparent"
                            Command="{Binding SetTransferCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsTransfer}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Transfer}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <!-- Amount -->
            <Border Style="{StaticResource Card}" Padding="18,22">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Amount" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding CurrencySymbol}" FontSize="36" FontFamily="OpenSansSemibold"
                               VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                        <Entry Text="{Binding AmountText}" Placeholder="0.00" Keyboard="Numeric"
                               FontSize="40" FontFamily="OpenSansSemibold" MinimumWidthRequest="200"
                               SemanticProperties.Description="Amount" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Category chips (transfers have no category) -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsTransfer, Converter={StaticResource InvertedBool}}">
                <Label Text="Category" Style="{StaticResource SectionTitle}" Margin="4,0,0,0" />
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Categories}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChipChoice">
                            <views:ChoiceChip>
                                <views:ChoiceChip.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type vm:TransactionEditViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </views:ChoiceChip.GestureRecognizers>
                            </views:ChoiceChip>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- Account chips -->
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding AccountLabel}" Style="{StaticResource SectionTitle}" Margin="4,0,0,0" />
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Accounts}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChipChoice">
                            <views:ChoiceChip>
                                <views:ChoiceChip.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectAccountCommand, Source={RelativeSource AncestorType={x:Type vm:TransactionEditViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </views:ChoiceChip.GestureRecognizers>
                            </views:ChoiceChip>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- Destination account chips (transfers only) -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsTransfer}">
                <Label Text="To account" Style="{StaticResource SectionTitle}" Margin="4,0,0,0" />
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding ToAccounts}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChipChoice">
                            <views:ChoiceChip>
                                <views:ChoiceChip.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectToAccountCommand, Source={RelativeSource AncestorType={x:Type vm:TransactionEditViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </views:ChoiceChip.GestureRecognizers>
                            </views:ChoiceChip>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- Details -->
            <Border Style="{StaticResource Card}" Padding="18,6">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,6">
                        <Label Text="{x:Static services:Icons.Calendar}" Style="{StaticResource Icon}" TextColor="{StaticResource Primary}" />
                        <DatePicker Grid.Column="1" Date="{Binding Date}" Format="dddd, MMMM d, yyyy" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,6">
                        <Label Text="{x:Static services:Icons.EditNote}" Style="{StaticResource Icon}" TextColor="{StaticResource Primary}" />
                        <Entry Grid.Column="1" Text="{Binding Note}" Placeholder="Add a note (optional)" MaxLength="120" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorText}" TextColor="{StaticResource Expense}" IsVisible="{Binding HasError}"
                   HorizontalOptions="Center" />

            <Button Text="Save" Command="{Binding SaveCommand}" HeightRequest="54"
                    FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="18" />
            <Button Text="Delete transaction" Command="{Binding DeleteCommand}" IsVisible="{Binding IsExisting}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Expense}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
